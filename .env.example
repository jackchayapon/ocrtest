# Backend เท่านั้น: ใส่ Neon connection string โดยคง sslmode=require
# ถ้าว่าง การพัฒนาใช้ PostgreSQL local ของ Compose
DATABASE_URL=
# Optional numeric-only SQL diagnostics for isolated validation; disabled by default.
DB_DIAGNOSTICS=false
# ใส่ Gateway API Key จริงเฉพาะในไฟล์ .env ส่วนตัวเท่านั้น
# ปกติไม่จำเป็นต้องใส่เครื่องหมายคำพูด หากค่าไม่มีช่องว่างหรืออักขระพิเศษ
# รูปแบบ token ปัจจุบันแนะนำไม่ใส่เครื่องหมายคำพูด และไม่เว้นวรรครอบ =
# ตัวอย่าง: MODEL_GATEWAY_API_KEY=your_real_gateway_key
MODEL_GATEWAY_BASE_URL=https://websolution.cdgs.co.th/paddle
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_TIMEOUT_SECONDS=240
MODEL_GATEWAY_MAX_RESPONSE_MB=64
# จำกัด adapter tasks และ field crops แยกจาก Gateway image batch size (30)
OCR_MAX_CONCURRENT_TASKS=4
OCR_MAX_CONCURRENT_FIELDS=8
# จำกัดขนาด batch ภายใต้ Gateway cap 30 เพื่อควบคุม RAM ของ REC response
OCR_GATEWAY_BATCH_SIZE=4
# CDGS: prefixes แยกบริการบน host เดียวกัน (route มีอยู่; readiness อาจไม่พร้อม)
# Gateway เดิมใช้ {} หรือไม่กำหนดตัวแปรนี้ได้ ห้ามใส่ host/API Key ใน JSON
MODEL_GATEWAY_SERVICE_PREFIXES={"paddle":null,"custom":null,"det_rec":"/paddle/api/v1","layout":"/paddle/api/v1","status":"/paddle/api/v1"}
# null = บริการไม่เปิดใช้งาน: ห้ามส่ง inference ไปบริการนั้น

STORAGE_MODE=local
# ทางเลือกสำหรับ native backend; Docker ใช้ volume /app/storage/uploads
# STORAGE_PATH=storage/uploads
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=20000
PDF_RENDER_DPI=200
MAX_PDF_PAGES=500
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ตัวแปร public สำหรับ URL ของ FastAPI เท่านั้น ห้ามใช้ prefix นี้กับ secrets
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ทุก Pipeline ใช้ MODEL_GATEWAY_BASE_URL และ MODEL_GATEWAY_API_KEY ด้านบนร่วมกัน
# ทางเลือก endpoint/engine สำหรับ seed config ใหม่; Config ที่มีอยู่แก้ผ่าน Pipeline Settings
MINT_OCR_ENDPOINT=/api/v1/ocr-results
MINT_OCR_ENGINE=custom
HUTCH_CROP_ENDPOINT=/api/v1/ocr-results
HUTCH_CROP_ENGINE=paddle
HUTCH_FULL_ENDPOINT=/api/v1/ocr-results
# TEST_DATABASE_URL ใช้เฉพาะการทดสอบกับ local *_test database ห้ามใช้ Neon production
# Optional: ตัวประมวลผลงาน OCR ใน service เดิม (ค่าเริ่มต้น true; ไม่ใช่ public variable)
OCR_JOBS_ENABLED=true
