# Backend เท่านั้น: ใส่ Neon connection string โดยคง sslmode=require
# ถ้าว่าง การพัฒนาใช้ PostgreSQL local ของ Compose
DATABASE_URL=
MODEL_GATEWAY_BASE_URL=http://107.129.186.30:62051
# รับ key จริงจากเจ้าของ Gateway; ถ้าว่าง OCR จะแจ้ง error ไม่สร้างผลแทน
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_TIMEOUT_SECONDS=240

STORAGE_MODE=local
# ทางเลือกสำหรับ native backend; Docker ใช้ volume /app/storage/uploads
# STORAGE_PATH=storage/uploads
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_DIMENSION=20000
PDF_RENDER_DPI=200
MAX_PDF_PAGES=500
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ตัวแปร public สำหรับ URL ของ FastAPI เท่านั้น ห้ามใช้ prefix นี้กับ secrets
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ทางเลือก native backend สำหรับ seed config ใหม่; Compose ใช้ shared Gateway ด้านบน
# Config ที่มีอยู่แก้ผ่าน Pipeline Settings; shared key มีลำดับสูงกว่า key ราย adapter
MINT_GATEWAY_BASE_URL=
MINT_OCR_ENDPOINT=/api/v1/ocr-results
MINT_OCR_ENGINE=custom
MINT_API_KEY=
HUTCH_GATEWAY_BASE_URL=
HUTCH_CROP_ENDPOINT=/api/v1/ocr-results
HUTCH_CROP_ENGINE=paddle
HUTCH_API_KEY=
HUTCH_FULL_BASE_URL=
HUTCH_FULL_ENDPOINT=/api/v1/ocr-results
HUTCH_FULL_API_KEY=
# TEST_DATABASE_URL ใช้เฉพาะการทดสอบกับ local *_test database ห้ามใช้ Neon production
