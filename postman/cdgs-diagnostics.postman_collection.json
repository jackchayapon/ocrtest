    },
    {
      "name": "03 Synthetic backend smoke (writes NEW records)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if(pm.environment.get('allow_synthetic_writes')!=='true') pm.execution.skipRequest();",
              "if(!pm.environment.get('field_id'))pm.environment.set('field_id',pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Upload NEW synthetic document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              }
            ],
            "url": "{{backend_base_url}}/api/documents",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{synthetic_image}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created',()=>pm.response.to.have.status(201));pm.environment.set('document_id',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create NEW synthetic case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{backend_base_url}}/api/test-cases",
            "body": {
              "mode": "raw",
              "raw": "{\"document_id\": \"{{document_id}}\", \"workflow\": \"global\", \"ground_truth_raw\": \"ทดสอบ CDGS 12345\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created',()=>pm.response.to.have.status(201));pm.environment.set('test_case_id',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm ONE synthetic field with manual GT",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{backend_base_url}}/api/test-cases/{{test_case_id}}/global-fields",
            "body": {
              "mode": "raw",
              "raw": "{\"confirmed\": true, \"fields\": [{\"id\": \"{{field_id}}\", \"field_index\": 1, \"source\": \"manual\", \"roi\": {\"x1\": 70, \"y1\": 65, \"x2\": 600, \"y2\": 150}, \"ground_truth_raw\": \"ทดสอบ CDGS 12345\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Run ONE pipeline ONE field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{backend_base_url}}/api/test-cases/{{test_case_id}}/run",
            "body": {
              "mode": "raw",
              "raw": "{\"pipelines\": [\"{{pipeline_id}}\"]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));const d=pm.response.json();pm.test('one successful pipeline and field',()=>{pm.expect(d.runs).to.have.lengthOf(1);pm.expect(d.runs[0].pipeline_id).to.eql(pm.environment.get('pipeline_id'));pm.expect(d.runs[0].status).to.eql('success');pm.expect(d.runs[0].fields).to.have.lengthOf(1);pm.expect(d.runs[0].fields[0].status).to.eql('success');});pm.environment.set('run_id',d.runs[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Validate saved OCR run",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              }
            ],
            "url": "{{backend_base_url}}/api/test-cases/{{test_case_id}}/results"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('saved run successful',()=>{const r=pm.response.json().runs.find(x=>x.id===pm.environment.get('run_id'));pm.expect(r).to.exist;pm.expect(r.status).to.eql('success');pm.expect(r.fields[0].diagnostics.gateway_request_id).to.be.a('string');});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}