{
  "info": {
    "name": "OCRLab CDGS bounded diagnostics",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('request_id','diag-'+pm.variables.replaceIn('{{$guid}}'));",
          "const u=pm.variables.replaceIn(pm.request.url.toString());",
          "const gateway=pm.environment.get('gateway_base_url');",
          "if(u.startsWith(gateway+'/') && gateway!=='https://websolution.cdgs.co.th/paddle/api/v1') throw new Error('Gateway host/prefix not approved');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(pm.response.code>=500 || pm.response.code===429) pm.execution.setNextRequest(null);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Read-only preflight",
      "item": [
        {
          "name": "Backend health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              }
            ],
            "url": "{{backend_base_url}}/api/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('DB and storage ready',()=>{const d=pm.response.json();pm.expect(d.database.status).to.eql('connected');pm.expect(d.storage.status).to.eql('ready');});"
                ]
              }
            }
          ]
        },
        {
          "name": "Pipeline catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              }
            ],
            "url": "{{backend_base_url}}/api/pipelines?fresh=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('catalog list',()=>pm.expect(pm.response.json()).to.be.an('array'));",
                  "const p=pm.response.json().find(p=>p.enabled&&p.source==='custom'&&p.execution_mode==='det_rec'&&p.det_model?.version==='6'&&p.det_model?.weight==='baseline'&&p.rec_model?.version==='5'&&p.rec_model?.weight==='baseline');if(p)pm.environment.set('pipeline_id',p.pipeline_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Model catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              }
            ],
            "url": "{{backend_base_url}}/api/pipelines/models?fresh=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));pm.test('models list',()=>pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Baseline sequential",
      "item": [
        {
          "name": "DET V6 baseline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Request-ID",
                "value": "{{request_id}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{gateway_api_key}}"
              }
            ],
            "url": "{{gateway_base_url}}/text-detection-batches?version=6&model=baseline",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "images",
                  "type": "file",
                  "src": "{{synthetic_image}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));const d=pm.response.json();pm.test('leaf envelope and selection',()=>{pm.expect(d.meta.request_id).to.be.a('string');pm.expect(d.meta.duration_ms).to.be.a('number');pm.expect(d.data.count).to.eql(1);pm.expect(d.data.model_selection.version).to.eql('v6');pm.expect(d.data.model_selection.variant).to.eql('baseline');const rows=d.data.results;pm.expect(rows).to.be.an('array').with.lengthOf(1);pm.expect(rows[0].dt_polys).to.be.an('array');pm.expect(rows[0].dt_scores).to.be.an('array');});"
                ]
              }
            }
          ]
        },
