# Generate a private, random key. Empty is fail-closed (HTTP503).
DOTS_API_KEY=
DOTS_MODEL_ID=dots-studio/dots.ocr
DOTS_BACKEND=transformers
DOTS_DEVICE=auto
DOTS_DTYPE=auto
DOTS_ATTENTION=sdpa
DOTS_HOST=0.0.0.0
DOTS_PORT=8092
# Local files only at runtime; download and verify the pinned snapshot first.
# Linux/CUDA alternative: DOTS_BACKEND=vllm, DOTS_MODEL_ID=dots-studio/dots.mocr
